<header class="sticky-header">
  <div class="wrapper">
    <div class="header-content">
      <div class="logo">
        <img src="/images/logo.png" alt="Логотип">
        <h1>My Skin Code</h1>
      </div>
      <nav>
        <ul>
          <li><a href="/" {{#if isIndex}}class="active"{{/if}}>Главная</a></li>

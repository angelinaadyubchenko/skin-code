<section class="form-page">
  <div class="wrapper">
    <div class="styled-form">
      <h2>Регистрация</h2>
      <p style="color: var(--text-mid); margin-bottom: 20px;">
        Новый пользователь будет сохранён в базе данных. Если имя указать как <strong>admin</strong>, аккаунт получит роль администратора.
      </p>

      {{#if error}}
      <p style="color: #b42318; margin-bottom: 20px;">{{error}}</p>
      {{/if}}

      <form action="/register" method="POST">
        <div class="form-group">
          <label>Имя</label>
          <input type="text" name="name" value="{{form.name}}" placeholder="Ваше имя" required>
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" value="{{form.email}}" placeholder="user@example.com" required>
        </div>
        <div class="form-group">
          <label>Пароль</label>
          <input type="password" name="password" placeholder="Минимум 6 символов" minlength="6" required>
        </div>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <button type="submit" class="btn">Зарегистрироваться</button>
          <a href="/login" class="btn btn-secondary">У меня уже есть аккаунт</a>
        </div>
      </form>
    </div>
  </div>
</section>
